# Matches the docker-compose.yml Postgres defaults — works out of the box
# with `docker compose up -d`. Point at your own database otherwise.
DATABASE_URL="postgresql://postgres:credo@localhost:5432/credo"

# Any long random string. Production requires 32+ characters.
JWT_SECRET="dev-only-change-me-dev-only-change-me"

# Optional: enables the AI coach. Without it the coach returns 503.
ANTHROPIC_API_KEY=""
